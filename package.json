{
  "name": "@inkwellgame/cli",
  "version": "0.0.1",
  "description": "Deploy browser games to Inkwell from the command line.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "inkwell": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import=tsx src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siliconjungle/inkwell-cli.git"
  },
  "bugs": {
    "url": "https://github.com/siliconjungle/inkwell-cli/issues"
  },
  "homepage": "https://inkwell.ing",
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
